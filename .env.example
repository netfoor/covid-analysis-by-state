# Conexión a MongoDB
MONGO_URI=mongodb://usuario:password@127.0.0.1:27017/?authSource=admin
DB_NAME=covid

# ── Configuración del estado a analizar ──────────────────────────────────────
# Clave numérica de la entidad federativa según catálogo SSa / INEGI
# Ejemplos: 09 = CDMX, 10 = DURANGO, 14 = JALISCO, 19 = NUEVO LEON
ENTIDAD_CLAVE=10

# Nombre en minúsculas para nombres de colecciones y archivos (sin acentos ni espacios)
ESTADO_NOMBRE=durango

# Población según Censo de Población y Vivienda 2020 (INEGI)
# Fuente: https://www.inegi.org.mx/sistemas/olap/consulta/general_ver4/MDXQueryDatos.asp?proy=
ESTADO_POB_TOTAL=1832650
ESTADO_POB_HOMBRES=904866
ESTADO_POB_MUJERES=927784
